+// scdaemon answers every command of a connection with CARD_REMOVED once a card
+// was removed, so a long-lived connection goes deaf after a replug.
+const gpgErrCardRemoved = gpgme.ErrorCode(110)
+
+func newAssuanContext() (*gpgme.Context, error) {
+	ctx, err := gpgme.New()
+	if err != nil {
+		return nil, err
+	}
+	if err := ctx.SetProtocol(gpgme.ProtocolAssuan); err != nil {
+		ctx.Release()
+		return nil, err
+	}
+	return ctx, nil
+}
+
