NIRI_HEADLESS=N starts niri on its headless backend, which upstream only
reaches from its own tests, with N 1920x1080 outputs.

--- a/src/main.rs
+++ b/src/main.rs
@@ -174,17 +174,26 @@
     // Increase the buffer size so that it's harder to crash a frozen client with a 1000 Hz mouse.
     set_default_max_buffer_size(&display, 1024 * 1024);
 
+    let headless = env::var_os("NIRI_HEADLESS").is_some();
     let mut state = State::new(
         config,
         event_loop.handle(),
         event_loop.get_signal(),
         display,
-        false,
+        headless,
         true,
         cli.session,
     )
     .unwrap();
 
+    if headless {
+        let State { backend, niri } = &mut state;
+        let outputs = env::var("NIRI_HEADLESS").ok().and_then(|n| n.parse().ok()).unwrap_or(1);
+        for n in 1..=outputs {
+            backend.headless().add_output(niri, n, (1920, 1080));
+        }
+    }
+
     // Set WAYLAND_DISPLAY for children.
     let socket_name = state.niri.socket_name.as_deref().unwrap();
     env::set_var("WAYLAND_DISPLAY", socket_name);
