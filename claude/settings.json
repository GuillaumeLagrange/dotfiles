{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": false,
  "attribution": {
    "commit": "Generated with AI Agent (Claude Code)!!!",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "autoUpdates": true,
  "effortLevel": "xhigh",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "notify-send 'Claude Code' \"Session in $(basename \"$CLAUDE_PROJECT_DIR\") needs attention\"",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.file_path' | { read -r f; case \"$f\" in *.rs) (cd \"$(dirname \"$f\")\" && cargo fmt -- \"$(basename \"$f\")\") 2>/dev/null || true ;; esac; }",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "~/dotfiles/claude/hooks/agent-diff-hook.sh PostToolUse",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/claude/hooks/agent-diff-hook.sh PreToolUse",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/AGENTS.md\" ]; then cat \"$CLAUDE_PROJECT_DIR/AGENTS.md\"; fi",
            "type": "command"
          },
          {
            "command": "awk 'NR==1&&/^---$/{f=1;next} f&&/^---$/{f=0;next} !f' \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/caveman/SKILL.md\" 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "bash '/home/guillaume/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/claude/hooks/agent-diff-hook.sh Stop",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": ["mcp__claude_ai_CodSpeed__compare_runs"],
    "defaultMode": "auto"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
  "verbose": true
}

