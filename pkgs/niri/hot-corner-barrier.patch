+    /// Keeps the pointer on `output` when it would leave it across an edge within `barrier`
+    /// pixels of an enabled hot corner or a `barrier-corners` one, so that the corner stays
+    /// easy to hit next to another output.
+    pub fn hot_corner_barrier(
+        &self,
+        output: &Output,
+        pos: Point<f64, Logical>,
+        mut new_pos: Point<f64, Logical>,
+    ) -> Point<f64, Logical> {
+        let hot_corners = self.hot_corners(output);
+        if hot_corners.barrier == 0 {
+            return new_pos;
+        }
+
+        let barrier = f64::from(hot_corners.barrier);
+        let geom = self.global_space.output_geometry(output).unwrap().to_f64();
+        let (left, top) = (geom.loc.x, geom.loc.y);
+        let (right, bottom) = (left + geom.size.w - 1., top + geom.size.h - 1.);
+
+        let hot = if hot_corners.off {
+            [false; 4]
+        } else {
+            Self::enabled_hot_corners(&hot_corners)
+        };
+        let only = hot_corners.barrier_corners;
+        for (enabled, at_left, at_top) in [
+            (hot[0] || only.top_left, true, true),
+            (hot[1] || only.top_right, false, true),
+            (hot[2] || only.bottom_left, true, false),
+            (hot[3] || only.bottom_right, false, false),
+        ] {
+            if !enabled {
+                continue;
+            }
+
+            let near_x = if at_left { pos.x - left } else { right - pos.x } < barrier;
+            let near_y = if at_top { pos.y - top } else { bottom - pos.y } < barrier;
+
+            if near_y {
+                new_pos.x = if at_left {
+                    new_pos.x.max(left)
+                } else {
+                    new_pos.x.min(right)
+                };
+            }
+            if near_x {
+                new_pos.y = if at_top {
+                    new_pos.y.max(top)
+                } else {
+                    new_pos.y.min(bottom)
+                };
+            }
+        }
+
+        new_pos
+    }
